# ---------------------------------------------------------------
#  Helmet AI Monitoring System — .gitignore
# ---------------------------------------------------------------

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- Virtual environments ----
venv/
.venv/
env/
ENV/

# ---- Environment / secrets ----
.env
.env.*

# ---- IDE / OS ----
.vscode/
.idea/
.claude/settings.local.json
Thumbs.db
desktop.ini
.DS_Store
~$*

# ---- Runtime data (created by app.py) ----
traffic_fines.db
*.db-journal
uploads/
violations/
static/uploads/
static/results/

# ---- YOLO training / prediction runs ----
# Keep only the trained helmet weights that app.py loads.
runs/*
!runs/detect/
runs/detect/*
!runs/detect/helmet_model3/
runs/detect/helmet_model3/*
!runs/detect/helmet_model3/weights/
runs/detect/helmet_model3/weights/*
!runs/detect/helmet_model3/weights/best.pt

# ---- Pretrained weights (Ultralytics downloads yolov8n.pt automatically) ----
yolov8n.pt

# ---- Datasets (re-download from Roboflow, see README) ----
dataset/
helmet_dataset/
train/
valid/
test/

# ---- Logs ----
*.log
